#!/usr/bin/env bash
# failglob: an SDK or reference-pack path that matches nothing fails here,
# rather than reaching csc as a literal glob and surfacing as a confusing
# compile error in the submitter's output.
set -euo pipefail
shopt -s failglob

export DOTNET_CLI_HOME=$PWD
export HOME=$PWD

rename 's/$/\.cs/' "$@" # Add .cs extension

# Same global usings the SDK's ImplicitUsings would generate for a console app.
cat > GlobalUsings.g.cs <<'EOF'
global using System;
global using System.Collections.Generic;
global using System.IO;
global using System.Linq;
global using System.Net.Http;
global using System.Threading;
global using System.Threading.Tasks;
EOF

cat > app.runtimeconfig.json <<'EOF'
{"runtimeOptions":{"tfm":"net10.0","framework":{"name":"Microsoft.NETCore.App","version":"10.0.0"}}}
EOF

# Calling Roslyn directly skips MSBuild evaluation, which is most of a
# project build's wall time for a single file.
refs=$(ls "$DOTNET_ROOT"/packs/Microsoft.NETCore.App.Ref/*/ref/net10.0/*.dll | sed 's/^/-r:/')

# csharp-ef also references EF Core and Npgsql, and copies the assemblies beside
# app.dll so the host's app-directory probe finds them at run time. Copies, not
# links: symlinks do not survive the move from the compile box to the run box.
# The largest assembly is under 3 MB, inside isolate's per-file size limit.
if [[ "${PISTON_LANGUAGE:-}" == "csharp-ef" ]]; then
    refs="$refs $(ls "$DOTNET_ROOT"/ef/*.dll | sed 's/^/-r:/')"
    cp "$DOTNET_ROOT"/ef/*.dll .
fi
registrations=()
if [[ "${PISTON_LANGUAGE:-}" == "csharp-tests" ]]; then
    refs="$refs $(ls "$DOTNET_ROOT"/tests/*.dll | sed 's/^/-r:/')"
    cp -R "$DOTNET_ROOT/tests/." .
    registrations=("$DOTNET_ROOT/tests-bootstrap/"*.cs)
fi
dotnet "$DOTNET_ROOT"/sdk/*/Roslyn/bincore/csc.dll -nologo -langversion:latest \
    -nullable:enable -optimize+ -out:app.dll "${registrations[@]}" $refs *.cs
